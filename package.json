{
	"name": "svelte-theme-parallax",
	"description": "Parallax — a dashboard theme kit for shadcn-svelte.",
	"keywords": [
		"svelte",
		"shadcn-svelte",
		"parallax",
		"tailwindcss",
		"ui",
		"components",
		"theme",
		"dashboard"
	],
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"author": "Sylvain Le Breton",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OctarinaCompany/svelte-theme-parallax.git"
	},
	"homepage": "https://octarinacompany.github.io/svelte-theme-parallax",
	"bugs": {
		"url": "https://github.com/OctarinaCompany/svelte-theme-parallax/issues"
	},
	"type": "module",
	"engines": {
		"node": "^22.12.0 || >=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && npm run site:prerender",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"themes:generate": "node tools/themes/generate.mjs",
		"themes:audit": "node tools/themes/audit.mjs all",
		"loaders:check": "node tools/loaders/check-styles.mjs",
		"registry:generate": "node tools/registry/generate.mjs",
		"registry:build": "npm run registry:generate && shadcn-svelte registry build --output ./public/r",
		"registry:sync": "node tools/registry/sync-official.mjs",
		"site:prerender": "node tools/site/prerender.mjs"
	},
	"devDependencies": {
		"@date-fns/tz": "^1.5.0",
		"@dnd-kit-svelte/svelte": "^0.1.5",
		"@dnd-kit/helpers": "^0.2.4",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@shikijs/langs": "^4.4.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/table-core": "^8.21.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.13.2",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"d3-shape": "^3.2.0",
		"date-fns": "^4.4.0",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "^2.3.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"qrcode": "^1.5.4",
		"shadcn-svelte": "^1.5.1",
		"shiki": "^4.4.3",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"svelte-streamdown": "^3.1.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.2.2",
		"zod": "^4.5.4"
	},
	"overrides": {
		"@dnd-kit/geometry": "^0.2.4"
	}
}
